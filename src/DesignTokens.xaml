<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 颜色令牌 -->
    <Color x:Key="ShadowColor">#0F172A</Color>
    <Color x:Key="ScrollShadowColor">#334155</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F6F8FC" />
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="DetailBrush" Color="#475569" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="PrimaryStrongBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#047857" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="WarningActionBrush" Color="#C2410C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerActionBrush" Color="#BE123C" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE4EE" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="PrimaryFocusBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="ToggleHoverBrush" Color="#B9C5D5" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF7ED" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FB923C" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#7C2D12" />
    <SolidColorBrush x:Key="ScrollEdgeBrush" Color="#D7E0EA" />
    <SolidColorBrush x:Key="WindowEdgeBrush" Color="#DCE3EC" />

    <!-- 字号令牌 -->
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBodyCompact">12.5</sys:Double>
    <sys:Double x:Key="FontSizeBody">13.5</sys:Double>
    <sys:Double x:Key="FontSizeLabel">14</sys:Double>
    <sys:Double x:Key="FontSizeEmphasis">15</sys:Double>
    <sys:Double x:Key="FontSizeSummary">16</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">17</sys:Double>
    <sys:Double x:Key="FontSizeTaskTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeAppTitle">27</sys:Double>

    <!-- 尺寸与节奏令牌 -->
    <sys:Double x:Key="ControlHeightDefault">42</sys:Double>
    <sys:Double x:Key="ControlHeightProminent">44</sys:Double>
    <sys:Double x:Key="ControlHeightCompact">36</sys:Double>
    <sys:Double x:Key="ProgressHeight">8</sys:Double>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="InnerCornerRadius">6</CornerRadius>
    <Thickness x:Key="CardSpacing">0,0,0,14</Thickness>
    <Thickness x:Key="HeaderInset">24,20,24,0</Thickness>
    <Thickness x:Key="WorkspaceInset">24,14,24,24</Thickness>
</ResourceDictionary>
