<Window x:Class="CodexPortableManager.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexPortableManager"
        Title="Codex Portable Manager"
        Width="1180"
        Height="820"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="CardStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            <Setter Property="Margin" Value="{StaticResource CardSpacing}" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSectionTitle}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBodyCompact}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ActionDescriptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource DetailBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBodyCompact}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Margin" Value="2,9,2,0" />
        </Style>

        <Style x:Key="FeatureDescriptionStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource DetailBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBodyCompact}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Margin" Value="0,5,16,0" />
        </Style>

        <Style x:Key="FeatureTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CompatibilityGroupStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource DetailBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CompatibilityStatusStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBodyCompact}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Margin" Value="18,0,12,0" />
        </Style>

        <Style x:Key="SubsectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="WorkspaceTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="{StaticResource ControlHeightDefault}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource PrimaryFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <UniformGrid x:Name="HeaderPanel"
                                             Rows="1"
                                             Columns="3"
                                             IsItemsHost="True"
                                             KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              Margin="0,12,0,0"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtonBaseStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="{StaticResource ControlHeightDefault}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CardCornerRadius}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryStrongBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DividerBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryStrongBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryStrongBrush}" />
        </Style>
        <Style x:Key="GreenButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
        </Style>
        <Style x:Key="WarningButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource WarningActionBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WarningActionBrush}" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource DangerActionBrush}" />
            <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerActionBrush}" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource SecondarySurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        </Style>
        <Style x:Key="CancelButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        </Style>

        <Style x:Key="ToggleSwitchFocusVisualStyle" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Border BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="2"
                                CornerRadius="14"
                                Margin="-3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource ToggleSwitchFocusVisualStyle}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Width="44" Height="24" Background="Transparent">
                            <Border x:Name="Track"
                                    CornerRadius="12"
                                    Background="{StaticResource ControlBorderBrush}"
                                    BorderBrush="{StaticResource DisabledTextBrush}"
                                    BorderThickness="1">
                                <Ellipse x:Name="Thumb"
                                         Width="18"
                                         Height="18"
                                         Margin="2"
                                         HorizontalAlignment="Left"
                                         Fill="{StaticResource SurfaceBrush}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource ToggleHoverBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="Grip" Width="5" Margin="1,2" CornerRadius="3" Background="{StaticResource DisabledTextBrush}" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Grip" Property="Background" Value="{StaticResource MutedBrush}" />
                                                        <Setter TargetName="Grip" Property="Width" Value="7" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Grip" Property="Background" Value="{StaticResource DetailBrush}" />
                                                        <Setter TargetName="Grip" Property="Width" Value="7" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent" Height="8">
                                    <Track x:Name="PART_Track" Orientation="Horizontal">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Opacity="0" Focusable="False" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb MinWidth="28">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="Grip" Height="5" Margin="2,1" CornerRadius="3" Background="{StaticResource DisabledTextBrush}" />
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource MutedBrush}" />
                                                                <Setter TargetName="Grip" Property="Height" Value="7" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Opacity="0" Focusable="False" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource HeaderInset}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="2,0,0,16">
                <TextBlock Text="Codex 便携版管理器"
                           FontSize="{StaticResource FontSizeAppTitle}"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="创建、更新并维护普通目录中的 Codex 便携版"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border x:Name="statusSummaryCard" Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12,18" Margin="0">
                <Grid x:Name="statusSummaryGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="portablePackageSummaryPanel" Grid.Column="0" Margin="22,0,16,0">
                        <TextBlock Text="便携版包版本" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBodyCompact}" FontWeight="SemiBold" />
                        <TextBlock x:Name="portableValueLabel" Text="检测中..." Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="{StaticResource FontSizeSummary}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border x:Name="statusWideSeparator0" Grid.Column="0" Width="1" Background="{StaticResource DividerBrush}" HorizontalAlignment="Right" />
                    <StackPanel x:Name="portableApplicationSummaryPanel" Grid.Column="1" Margin="22,0,16,0">
                        <TextBlock Text="便携版应用版本" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBodyCompact}" FontWeight="SemiBold" />
                        <TextBlock x:Name="portableApplicationValueLabel" Text="检测中..." Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="{StaticResource FontSizeSummary}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border x:Name="statusWideSeparator1" Grid.Column="1" Width="1" Background="{StaticResource DividerBrush}" HorizontalAlignment="Right" />
                    <StackPanel x:Name="latestPackageSummaryPanel" Grid.Column="2" Margin="22,0,16,0">
                        <TextBlock Text="微软最新包版本" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBodyCompact}" FontWeight="SemiBold" />
                        <TextBlock x:Name="latestValueLabel" Text="尚未检查" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="{StaticResource FontSizeSummary}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border x:Name="statusWideSeparator2" Grid.Column="2" Width="1" Background="{StaticResource DividerBrush}" HorizontalAlignment="Right" />
                    <StackPanel x:Name="overallStatusSummaryPanel" Grid.Column="3" Margin="22,0,10,0">
                        <TextBlock Text="状态" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeBodyCompact}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border x:Name="statusIndicator" Width="10" Height="10" CornerRadius="5" Background="{StaticResource DisabledTextBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock x:Name="statusValueLabel" Text="正在检测" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="{StaticResource FontSizeSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="statusNarrowTopSeparator"
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="1"
                            Background="{StaticResource DividerBrush}"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed" />
                    <Border x:Name="statusNarrowBottomSeparator"
                            Grid.Row="1"
                            Grid.Column="0"
                            Width="1"
                            Background="{StaticResource DividerBrush}"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed" />
                    <Border x:Name="statusNarrowRowSeparator"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Height="1"
                            Background="{StaticResource DividerBrush}"
                            VerticalAlignment="Top"
                            Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="workspaceGrid" Grid.Row="1" Margin="{StaticResource WorkspaceInset}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <TabControl x:Name="mainTabControl"
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource WorkspaceTabControlStyle}"
                        SelectedIndex="0"
                        AutomationProperties.Name="管理器功能页">
                <TabItem Header="版本管理"
                         Style="{StaticResource WorkspaceTabItemStyle}"
                         AutomationProperties.Name="版本管理">
                    <ScrollViewer x:Name="mainScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  CanContentScroll="False">
                        <StackPanel Margin="0,0,4,0">
                            <Border Style="{StaticResource CardStyle}" Padding="20,17">
                                <StackPanel>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Content="便携版目标目录"
                                               Target="{Binding ElementName=installPathTextBox}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center"
                                               Padding="0"
                                               Margin="0,0,18,0" />
                                        <TextBox x:Name="installPathTextBox"
                                                 Grid.Column="1"
                                                 Height="{StaticResource ControlHeightDefault}"
                                                 VerticalContentAlignment="Center"
                                                 Padding="12,0"
                                                 Background="{StaticResource ControlSurfaceBrush}"
                                                 BorderBrush="{StaticResource ControlBorderBrush}"
                                                 BorderThickness="1"
                                                 FontSize="{StaticResource FontSizeLabel}"
                                                 AutomationProperties.Name="便携版目标目录" />
                                        <Button x:Name="browseButton" Grid.Column="2" Content="选择位置" Style="{StaticResource SecondaryButtonStyle}" MinWidth="104" Margin="12,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="显示最终写入位置。若所选目录已有其他内容，管理器会自动选择独立的 Codex 或 Codex-N 子目录。"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,9,0,0" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="storeWarningCard" Style="{StaticResource CardStyle}" Padding="22,18" Background="{StaticResource WarningSurfaceBrush}" BorderBrush="{StaticResource WarningBorderBrush}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="storeValueLabel" Text="检测到官方桌面版（Microsoft Store / MSIX）" Foreground="{StaticResource TextBrush}" FontSize="{StaticResource FontSizeEmphasis}" FontWeight="Bold" />
                                        <TextBlock Text="官方桌面版由 Windows 管理，本工具不会修改其 WindowsApps 文件。可以保留，但不建议与便携版同时运行。"
                                                   Foreground="{StaticResource WarningTextBrush}"
                                                   FontSize="{StaticResource FontSizeBodyCompact}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,20,0" />
                                    </StackPanel>
                                    <Button x:Name="migrateButton" Grid.Column="1" Content="迁移并卸载官方版" Style="{StaticResource WarningButtonStyle}" MinWidth="176" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Padding="22,18" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="安装与更新" Style="{StaticResource SectionTitleStyle}" />
                                    <local:ResponsiveButtonPanel MinimumItemWidth="185" Spacing="14" RowSpacing="14" Margin="0,14,0,0">
                                        <Grid MinHeight="82">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Button x:Name="installButton" Content="创建 / 更新 / 修复" Style="{StaticResource PrimaryButtonStyle}" Height="{StaticResource ControlHeightProminent}" />
                                            <TextBlock Grid.Row="1" Text="创建便携版；已有版本则更新或重新解包修复" Style="{StaticResource ActionDescriptionStyle}" />
                                        </Grid>
                                        <Grid MinHeight="82">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Button x:Name="launchButton" Content="启动便携版" Style="{StaticResource GreenButtonStyle}" Height="{StaticResource ControlHeightProminent}" />
                                            <TextBlock Grid.Row="1" Text="从当前目标目录启动 Codex" Style="{StaticResource ActionDescriptionStyle}" />
                                        </Grid>
                                        <Grid MinHeight="82">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Button x:Name="checkButton" Content="检查新版本" Style="{StaticResource SecondaryButtonStyle}" Height="{StaticResource ControlHeightProminent}" />
                                            <TextBlock Grid.Row="1" Text="检查微软版本与本机安装状态，不修改 Codex 文件" Style="{StaticResource ActionDescriptionStyle}" />
                                        </Grid>
                                        <Grid MinHeight="82">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
