                                     Foreground="{StaticResource DividerBrush}"
                                     BorderThickness="0"
                                     Padding="11"
                                     FontFamily="Consolas"
                                     FontSize="{StaticResource FontSizeBodyCompact}"
                                     AutomationProperties.Name="运行日志"
                                     AutomationProperties.HelpText="只读操作日志，可使用打开目录按钮查看日志文件。" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Height="1"
                VerticalAlignment="Top"
                Background="{StaticResource WindowEdgeBrush}"
                IsHitTestVisible="False"
                Panel.ZIndex="10" />
    </Grid>
</Window>
